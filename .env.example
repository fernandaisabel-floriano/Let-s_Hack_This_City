# Copiar para .env e preencher (o .env não vai para o git).

# Mapillary: token gratuito em https://www.mapillary.com/dashboard/developers
# Só é preciso para descarregar imagens (pipeline/fetch_mapillary.py ou aba Importação).
MAPILLARY_TOKEN=

# Opcionais (variáveis de ambiente, não precisam de estar aqui):
#   CTRLF_ZONA=av-lourenco-peixinho     zona a processar (por omissão, a de config/municipio.yaml)
#   CTRLF_CONFIG=outro/municipio.yaml   outro ficheiro de configuração
#   CTRLF_PYTHON=/caminho/para/python   Python que a app usa (por omissão: .venv, depois o PATH)
